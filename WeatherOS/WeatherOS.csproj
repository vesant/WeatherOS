<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- O Cosmos DevKit atual compila sobre .NET 6.0 ou .NET 8.0 em modo x86 -->
    <TargetFramework>net6.0</TargetFramework>
    <Platform>x86</Platform>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    
    <!-- Configuração do Compilador IL2CPU do Cosmos -->
    <CosmosBuildType>Kernel</CosmosBuildType>
    <Description>WeatherOS - Dedicated Meteorological Operating System</Description>
  </PropertyGroup>

  <!-- Dependências Oficiais do Cosmos OS -->
  <ItemGroup>
    <PackageReference Include="Cosmos.System2" Version="0.1.0-localbuild" />
    <PackageReference Include="Cosmos.Core" Version="0.1.0-localbuild" />
    <PackageReference Include="Cosmos.HAL2" Version="0.1.0-localbuild" />
    <PackageReference Include="Cosmos.Debug.Kernel" Version="0.1.0-localbuild" />
  </ItemGroup>

</Project>