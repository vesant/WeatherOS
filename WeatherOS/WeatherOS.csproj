<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <!--<RuntimeIdentifier>cosmos</RuntimeIdentifier>-->
        <Platform>cosmos</Platform>
        <SupportsX86Intrinsics>false</SupportsX86Intrinsics>
        <SelfContained>True</SelfContained>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <PropertyGroup>
        <EnableGDB>False</EnableGDB>
        <StartCosmosGDB>False</StartCosmosGDB>
        <VisualStudioDebugPort>Pipe: Cosmos\Serial</VisualStudioDebugPort>
        <CosmosDebugPort>Serial: COM1</CosmosDebugPort>
        <Launch>VMware</Launch>
        <Profile>VMware</Profile>
        <Description>Use VMware Player or Workstation to deploy and debug.</Description>
        <PxeInterface>192.168.0.8</PxeInterface>
        <DebugEnabled>False</DebugEnabled>
        <RemoveBootDebugOutput>True</RemoveBootDebugOutput>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Cosmos.Build" Version="0-*" NoWarn="NU1604" />
        <PackageReference Include="Cosmos.Debug.Kernel" Version="0-*" NoWarn="NU1604" />
        <PackageReference Include="Cosmos.System2" Version="0-*" NoWarn="NU1604" />
        <PackageReference Include="IL2CPU.API" Version="0.1.0-localbuild20221121060004" />
    </ItemGroup>

    <Target Name="AssembleBootloaderPayload" BeforeTargets="BeforeBuild;CoreCompile">
        <Exec Command="python &quot;$(MSBuildThisFileDirectory)..\scratch\update_payload.py&quot;" Condition="Exists('$(MSBuildThisFileDirectory)..\scratch\update_payload.py')" />
        <Exec Command="python &quot;$(MSBuildThisFileDirectory)..\..\scratch\update_payload.py&quot;" Condition="!Exists('$(MSBuildThisFileDirectory)..\scratch\update_payload.py')" />
    </Target>

    <Target Name="AlignKernelStart" AfterTargets="IL2CPU" BeforeTargets="Nasm">
        <Exec Command="python &quot;$(MSBuildThisFileDirectory)..\scratch\patch_kernel_alignment.py&quot; &quot;$(MSBuildThisFileDirectory)bin\cosmos\$(Configuration)\$(TargetFramework)\$(TargetName).asm&quot;" Condition="Exists('$(MSBuildThisFileDirectory)..\scratch\patch_kernel_alignment.py')" />
        <Exec Command="python &quot;$(MSBuildThisFileDirectory)..\..\scratch\patch_kernel_alignment.py&quot; &quot;$(MSBuildThisFileDirectory)bin\cosmos\$(Configuration)\$(TargetFramework)\$(TargetName).asm&quot;" Condition="!Exists('$(MSBuildThisFileDirectory)..\scratch\patch_kernel_alignment.py')" />
    </Target>

    <Target Name="GenerateNativeBootloader" AfterTargets="MakeIso">
        <Exec Command="python &quot;$(MSBuildThisFileDirectory)..\make_isohybrid.py&quot;" />
    </Target>
</Project>
