<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- O Cosmos DevKit atual compila sobre .NET 6.0 ou .NET 8.0 em modo x86 -->
    <TargetFramework>net6.0</TargetFramework>
    <Platform>x86</Platform>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    
    <!-- Cosmos Build Mode: ISO generates a bootable image for VirtualBox, VMware, and QEMU -->
    <CosmosBuildType>ISO</CosmosBuildType>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <Description>WeatherOS - Dedicated Meteorological Operating System</Description>
  </PropertyGroup>

  <!-- Dependências Oficiais do Cosmos OS (MyGet Feed) -->
  <ItemGroup>
    <PackageReference Include="Cosmos.System2" Version="0.1.0-*" />
    <PackageReference Include="Cosmos.Core" Version="0.1.0-*" />
    <PackageReference Include="Cosmos.HAL2" Version="0.1.0-*" />
    <PackageReference Include="Cosmos.Debug.Kernel" Version="0.1.0-*" />
  </ItemGroup>

</Project>